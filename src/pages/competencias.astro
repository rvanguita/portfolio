---
import Layout from "@components/layout/Layout.astro";
import Skills from "@components/panels/Skills.astro";
import { url } from "@lib/url";
---

<Layout
  title="Competências · Rene Anguita"
  description="Competências de Rene Anguita em Engenharia de Dados: Python, SQL, Airflow, Delta Lake e PySpark, com aplicações em machine learning, visualização e otimização."
  current="competencias"
>
  <div class="page">
    <a class="backlink" href={url("/")}>← Início</a>
    <div class="mod-head"><h1>Competências</h1></div>
    <p class="module-intro">
      Da preparação dos dados ao uso em análises e aplicações. Conheça as
      tecnologias e os métodos que utilizo, com exemplos nos meus projetos.
    </p>
    <Skills />
  </div>
</Layout>

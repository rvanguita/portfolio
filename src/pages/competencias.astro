---
import Layout from "@components/layout/Layout.astro";
import { skills } from "@data/skills";
import { url } from "@lib/url";
---

<Layout
  title="Competências · Rene Anguita"
  description="Competências de Rene Anguita em Engenharia de Dados: Python, SQL, Airflow, Delta Lake e PySpark, com repertório em machine learning, visualização e otimização."
  current="competencias"
>
  <div class="page">
    <a class="backlink" href={url("/")}>← Início</a>
    <div class="mod-head"><h1>Competências</h1></div>
    <p class="module-intro">
      Engenharia de dados como base. Machine learning, visualização e otimização
      para conectar a preparação dos dados às perguntas de negócio.
    </p>
    <dl class="skills">
      {
        skills.map((g) => (
          <div class="skill">
            <div class="skill-head">
              <dt>{g.title}</dt>
            </div>
            <dd>
              <ul class="tech-tags">
                {g.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
    <p class="skill-evidence">
      <a href={url("/projetos/")}
        >Veja essas competências aplicadas nos projetos <span aria-hidden="true"
          >→</span
        ></a
      >
    </p>
  </div>
</Layout>

---
import { getCollection } from "astro:content";
import Layout from "@components/layout/Layout.astro";
import Channels from "@components/panels/Channels.astro";
import Pipeline from "@components/viz/Pipeline.astro";
import { profile } from "@data/profile";
import { certTotal } from "@data/certificates";
import { url, absoluteUrl } from "@lib/url";

const projects = (await getCollection("projetos")).sort(
  (a, b) => a.data.order - b.data.order,
);
const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  alternateName: "rvanguita",
  url: absoluteUrl(url("/"), Astro.site),
  image: absoluteUrl(url(profile.ogImage), Astro.site),
  jobTitle: profile.roleShort,
  email: `mailto:${profile.email}`,
  sameAs: [profile.links.github, profile.links.linkedin],
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Universidade Estadual de Campinas (UNICAMP)",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Campinas",
    addressRegion: "SP",
    addressCountry: "BR",
  },
  knowsAbout: [
    "Engenharia de Dados",
    ...profile.highlights,
    "Machine Learning",
    "Otimização",
  ],
};
---

<Layout title={`${profile.shortName} · Engenharia de Dados`} current="home">
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />
  <div class="page page--home">
    <header class="hero">
      <div class="hero-copy">
        <p class="hero-name">{profile.shortName}</p>
        <h1>{profile.roleShort}<span class="hero-period">.</span></h1>
        <p class="lead" set:html={profile.leadHtml} />
        <p class="hero-credential">{profile.credential}</p>
        <ul class="tech-tags hero-tech" aria-label="Tecnologias principais">
          {profile.highlights.map((tech) => <li>{tech}</li>)}
        </ul>
        <div class="hero-contact">
          <a class="button button--primary" href="#projetos"
            >Ver projetos <span aria-hidden="true">↓</span></a
          >
          <a
            class="button button--secondary"
            href={profile.links.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            >Conversar no LinkedIn <span aria-hidden="true">↗</span></a
          >
        </div>
        <div class="hero-links">
          <a href={`mailto:${profile.email}`}>Enviar e-mail</a>
          <a
            href={profile.links.github}
            target="_blank"
            rel="noopener noreferrer">GitHub ↗</a
          >
          <a
            href={url(profile.links.dossie)}
            target="_blank"
            rel="noopener noreferrer">Dossiê profissional (PDF) ↓</a
          >
        </div>
        <p class="availability">
          {profile.location}<br />{profile.availability}
        </p>
      </div>
      <Pipeline />
    </header>
    <section aria-labelledby="projetos" class="featured-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Projetos selecionados</p>
          <h2 id="projetos">Engenharia de dados em prática.</h2>
          <p class="section-intro">
            Ingestão, organização e disponibilização de dados em projetos
            completos.
          </p>
        </div>
        <a class="text-link" href={url("/projetos/")}
          >Ver os {projects.length} projetos <span aria-hidden="true">↗</span
          ></a
        >
      </div>
      <Channels projects={projects.slice(0, 3)} level={3} />
    </section>
    <section class="background-section" aria-labelledby="base-profissional">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Além dos projetos</p>
          <h2 id="base-profissional">Pesquisa, método e repertório técnico.</h2>
        </div>
      </div>
      <nav class="modules" aria-label="Formação e competências">
        <a class="module-link" href={url("/competencias/")}>
          <span class="module-label"
            >Competências <span aria-hidden="true">↗</span></span
          >
          <span class="module-description"
            >Engenharia de dados, machine learning, visualização e otimização.</span
          >
          <span class="module-meta">Conheça as tecnologias</span>
        </a>
        <a class="module-link" href={url("/trajetoria/")}>
          <span class="module-label"
            >Trajetória <span aria-hidden="true">↗</span></span
          >
          <span class="module-description"
            >Da Engenharia Elétrica à pesquisa aplicada e aos sistemas de dados.</span
          >
          <span class="module-meta">Ph.D. pela UNICAMP</span>
        </a>
        <a class="module-link" href={url("/certificacoes/")}>
          <span class="module-label"
            >Certificações <span aria-hidden="true">↗</span></span
          >
          <span class="module-description"
            >Formação complementar em Python, estatística e análise de negócios.</span
          >
          <span class="module-meta">{certTotal} certificados disponíveis</span>
        </a>
      </nav>
    </section>
  </div>
</Layout>

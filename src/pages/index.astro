---
import { getCollection } from "astro:content";
import Layout from "@components/layout/Layout.astro";
import Channels from "@components/panels/Channels.astro";
import Trace from "@components/viz/Trace.astro";
import { profile } from "@data/profile";
import { skills } from "@data/skills";
import { certTotal } from "@data/certificates";
import { url, absoluteUrl } from "@lib/url";

const projects = (await getCollection("projetos")).sort(
  (a, b) => a.data.order - b.data.order,
);
const n = String(projects.length).padStart(2, "0");

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  alternateName: "rvanguita",
  url: absoluteUrl(url("/"), Astro.site),
  image: absoluteUrl(url(profile.ogImage), Astro.site),
  jobTitle: "Cientista de Dados",
  email: `mailto:${profile.email}`,
  sameAs: [profile.links.github, profile.links.linkedin],
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Universidade Estadual de Campinas (UNICAMP)",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Campinas",
    addressRegion: "SP",
    addressCountry: "BR",
  },
  knowsAbout: [
    "Ciência de Dados",
    "Machine Learning",
    "Otimização",
    "Pesquisa Operacional",
  ],
};
---

<Layout title="rvanguita" current="home">
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />

  <div class="page">
    <header class="hero">
      <div class="hero-copy">
        <p class="hero-eyebrow">
          <span aria-hidden="true">●</span> sinal ativo · disponível para novos desafios
        </p>
        <h1>{profile.name}</h1>
      </div>
      <p class="role">{profile.role}</p>
      <p class="lead" set:html={profile.leadHtml} />

      <div class="hero-contact">
        <a
          class="contact-primary"
          href={profile.links.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          >Conectar no LinkedIn <span aria-hidden="true">↗</span></a
        >
        <a href={`mailto:${profile.email}`}>Enviar e-mail</a>
        <a href={profile.links.github} target="_blank" rel="noopener noreferrer"
          >Ver GitHub <span aria-hidden="true">↗</span></a
        >
        <a
          href={url(profile.links.dossie)}
          target="_blank"
          rel="noopener noreferrer"
          >Baixar dossiê <span aria-hidden="true">↓</span></a
        >
      </div>
      <p class="availability">
        <span>{profile.location}</span> · {profile.availability}
      </p>

      <div class="intro-trace">
        <Trace
          variant="convergence"
          caption="convergência de uma busca metaheurística — custo por iteração"
        />
      </div>

      <dl class="hero-signals" aria-label="Resumo do portfólio">
        <div><dt>projetos publicados</dt><dd>{n}</dd></div>
        <div><dt>frentes de atuação</dt><dd>{skills.length}</dd></div>
        <div><dt>certificações</dt><dd>{certTotal}</dd></div>
      </dl>
    </header>

    <h2 class="section-rule" id="projetos">
      Evidências de trabalho <span class="count">[{n} projetos · impacto]</span>
    </h2>
    <Channels projects={projects} level={3} />

    <h2 class="section-rule">Mais evidências</h2>
    <nav class="modules" aria-label="Formação e competências">
      <a class="module-link" href={url("/trajetoria/")}>
        <span class="name">Trajetória</span><span class="count">2012–26</span>
      </a>
      <a class="module-link" href={url("/competencias/")}>
        <span class="name">Competências</span><span class="count"
          >[0{skills.length}]</span
        >
      </a>
      <a class="module-link" href={url("/certificacoes/")}>
        <span class="name">Certificações</span><span class="count"
          >[{certTotal}]</span
        >
      </a>
    </nav>
  </div>
</Layout>

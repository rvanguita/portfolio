---
import { getCollection } from "astro:content";
import Layout from "@components/layout/Layout.astro";
import Channels from "@components/panels/Channels.astro";
import Skills from "@components/panels/Skills.astro";
import Pipeline from "@components/viz/Pipeline.astro";
import { profile } from "@data/profile";
import { certGroups, certTotal } from "@data/certificates";
import { url, absoluteUrl } from "@lib/url";
import { METRIC_TAG } from "@lib/metric";

const projects = (await getCollection("projetos")).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = projects.slice(0, 3);
const spotlight = featured.find((project) => project.id === "fastf1");
const supporting = featured.filter((project) => project !== spotlight);

// O tipo de resultado e a ressalva vêm do próprio projeto: a abertura repete
// exatamente o que o cartão e a legenda do catálogo dizem sobre o FastF1.
const spotlightNote = spotlight
  ? [METRIC_TAG[spotlight.data.metricKind], spotlight.data.metric.sub]
      .filter(Boolean)
      .join(" · ") + "."
  : "";

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  alternateName: "rvanguita",
  url: absoluteUrl(url("/"), Astro.site),
  image: absoluteUrl(url(profile.ogImage), Astro.site),
  jobTitle: ["Engenheiro de Dados", "Data Engineer"],
  description: profile.description,
  email: `mailto:${profile.email}`,
  sameAs: [profile.links.github, profile.links.linkedin],
  knowsLanguage: [
    { "@type": "Language", name: "Português", alternateName: "pt" },
    { "@type": "Language", name: "Inglês", alternateName: "en" },
  ],
  seeks: {
    "@type": "Demand",
    name: "Engenheiro de Dados pleno · Cientista de Dados · ML Engineer",
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Universidade Estadual de Campinas (UNICAMP)",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Campinas",
    addressRegion: "SP",
    addressCountry: "BR",
  },
  // Termos de busca em pt e en. A regra: só entra capacidade que o site
  // evidencia — nas stacks dos projetos ou nas competências. O sinônimo em
  // inglês do que já aparece em português é aceito, porque é como o leitor
  // procura; capacidade sem lastro no texto visível, não.
  knowsAbout: [
    "Engenharia de Dados",
    "Data Engineering",
    "Lakehouse",
    "MLOps",
    "Machine Learning",
    "Python",
    "SQL",
    "PySpark",
    "Apache Spark",
    "Delta Lake",
    "Apache Airflow",
    "Docker",
    "FastAPI",
    "Otimização",
  ],
};
---

<Layout
  title={`${profile.shortName} · Engenheiro de Dados | Data Engineer`}
  current="home"
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />

  <div class="hero">
    <header class="hero-copy">
      <p class="hero-status">{profile.availabilityShort}</p>
      <p class="hero-name">{profile.shortName}</p>
      <h1>{profile.roleShort}<span aria-hidden="true">.</span></h1>
      <p class="lead" set:html={profile.leadHtml} />
      <p class="hero-credential">
        {profile.credential}<br />{profile.location}<br />{profile.heroFacts}
      </p>
      <ul class="tech-tags hero-tech" aria-label="Tecnologias principais">
        {profile.highlights.map((tech) => <li>{tech}</li>)}
      </ul>
      <div class="hero-contact">
        <a class="button button--primary" href="#projetos"
          >Ver projetos <span aria-hidden="true">↓</span></a
        >
        <a class="button button--secondary" href={`mailto:${profile.email}`}
          >Entrar em contato <span aria-hidden="true">↗</span></a
        >
        <a
          class="button button--secondary"
          href={url(profile.links.dossie)}
          target="_blank"
          rel="noopener noreferrer"
          >Currículo em PDF <span aria-hidden="true">↓</span></a
        >
      </div>
    </header>

    {
      spotlight && (
        <article class="spotlight" aria-labelledby="projeto-destaque">
          <p class="eyebrow">Projeto em destaque · {spotlight.data.category}</p>
          <h2 id="projeto-destaque">
            <a href={url(`/projetos/${spotlight.id}/`)}>
              {spotlight.data.title}
            </a>
          </h2>
          <p class="spotlight-summary">{spotlight.data.summary}</p>
          {spotlight.data.architecture && (
            <Pipeline
              architecture={spotlight.data.architecture}
              headingId="pipeline-abertura"
            />
          )}
          <p class="spotlight-note">{spotlightNote}</p>
          <div class="spotlight-links">
            <a class="text-link" href={url(`/projetos/${spotlight.id}/`)}>
              Ver estudo de caso <span aria-hidden="true">→</span>
            </a>
            {spotlight.data.repos.map((repo) => (
              <a
                class="text-link"
                href={repo.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Ver código de ${spotlight.data.title} no ${repo.label}`}
              >
                Ver código <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </article>
      )
    }
  </div>

  <div class="page page--home">
    <section class="section" aria-labelledby="projetos">
      <div class="section-head">
        <div>
          <p class="eyebrow">Engenharia de dados e machine learning</p>
          <h2 id="projetos">Projetos selecionados</h2>
          <p class="section-intro">
            Cada ficha traz o problema, a decisão técnica que pesou e o
            resultado — com o código aberto ao lado.
          </p>
        </div>
        <a class="text-link" href={url("/projetos/")}
          >Ver todos os projetos <span aria-hidden="true">→</span></a
        >
      </div>
      <Channels projects={supporting} level={3} columns={2} />
    </section>

    <section class="section" aria-labelledby="competencias">
      <div class="section-head">
        <div>
          <p class="eyebrow">Competências aplicadas</p>
          <h2 id="competencias">O que eu construo com dados</h2>
          <p class="section-intro">
            Engenharia de dados como base, com repertório em machine learning,
            análise e otimização — cada grupo ligado aos projetos que o provam.
          </p>
        </div>
        <a class="text-link" href={url("/competencias/")}
          >Explorar competências <span aria-hidden="true">→</span></a
        >
      </div>
      <Skills compact />
    </section>

    <section class="section" aria-labelledby="formacao">
      <div class="background">
        <div>
          <p class="eyebrow">Formação e pesquisa</p>
          <h2 id="formacao">Engenharia, pesquisa e resolução de problemas.</h2>
          <p>
            Doutorado em Engenharia Elétrica pela UNICAMP (2019–2025), com
            pesquisa em otimização de sistemas elétricos e métodos de decisão.
            Seis anos modelando problemas, defendendo escolhas com evidência e
            construindo processos reproduzíveis em Python — a mesma disciplina
            que hoje aplico a pipelines e lakehouses.
          </p>
          <a class="text-link" href={url("/trajetoria/")}
            >Conhecer minha trajetória <span aria-hidden="true">→</span></a
          >
        </div>
        <div class="background-certs">
          <h3>Formação complementar</h3>
          <ul class="cert-topics">
            {certGroups.map((group) => <li>{group.short}</li>)}
          </ul>
          <a class="text-link" href={url("/certificacoes/")}
            >Ver os {certTotal} certificados <span aria-hidden="true">→</span
            ></a
          >
        </div>
      </div>
    </section>

    <section class="contact" aria-labelledby="contato">
      <div>
        <p class="eyebrow">Vamos conversar</p>
        <h2 id="contato">Sua equipe precisa de um engenheiro de dados?</h2>
        <p>{profile.availability}</p>
        <dl class="screening">
          {
            profile.screening.map((fact) => (
              <div class="screening-row">
                <dt>{fact.term}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="contact-actions">
        <a class="button button--primary" href={`mailto:${profile.email}`}
          >{profile.email} <span aria-hidden="true">↗</span></a
        >
        <a
          class="text-link"
          href={profile.links.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          >Conversar pelo LinkedIn <span aria-hidden="true">↗</span></a
        >
      </div>
    </section>
  </div>
</Layout>

---
import { getCollection } from "astro:content";
import Layout from "../components/Layout.astro";
import Channels from "../components/Channels.astro";
import RepoList from "../components/RepoList.astro";
import Trace from "../components/Trace.astro";
import { profile } from "../data/profile";
import { skills } from "../data/skills";
import { certTotal } from "../data/certificates";
import { pickExtras, warnMissing } from "../data/github";
import { url, absoluteUrl } from "../lib/url";

const projects = (await getCollection("projetos")).sort(
  (a, b) => a.data.order - b.data.order,
);
const n = String(projects.length).padStart(2, "0");

const claimed = projects.flatMap((p) =>
  [p.data.repo, ...p.data.reposGh].filter((x): x is string => !!x),
);
warnMissing(claimed);
const extras = pickExtras(claimed);
const en = String(extras.length).padStart(2, "0");

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  alternateName: "rvanguita",
  url: absoluteUrl(url("/"), Astro.site),
  image: absoluteUrl(url(profile.ogImage), Astro.site),
  jobTitle: "Cientista de Dados",
  email: `mailto:${profile.email}`,
  sameAs: [profile.links.github, profile.links.linkedin],
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Universidade Estadual de Campinas (UNICAMP)",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Campinas",
    addressRegion: "SP",
    addressCountry: "BR",
  },
  knowsAbout: [
    "Ciência de Dados",
    "Machine Learning",
    "Otimização",
    "Pesquisa Operacional",
  ],
};
---

<Layout title="rvanguita" current="home">
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />

  <div class="page">
    <header class="hero">
      <h1>{profile.name}</h1>
      <p class="role">{profile.role}</p>
      <p class="lead" set:html={profile.leadHtml}></p>

      <p class="contact">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href={profile.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href={url(profile.links.dossie)} target="_blank" rel="noopener noreferrer">Dossiê (PDF)</a>
        <span class="sep" aria-hidden="true">·</span>
        {profile.location}
      </p>
      <p class="availability">{profile.availability}</p>

      <div class="intro-trace">
        <Trace
          variant="convergence"
          caption="convergência de uma busca metaheurística — custo por iteração"
        />
      </div>
    </header>

    <h2 class="section-rule" id="projetos">
      Projetos <span class="count">[{n}]</span>
    </h2>
    <Channels projects={projects} level={3} />

    <h2 class="section-rule">Registros</h2>
    <nav class="modules" aria-label="Outras seções">
      <a class="module-link" href={url("/trajetoria/")}>
        <span class="name">Trajetória</span><span class="count">2012–26</span>
      </a>
      <a class="module-link" href={url("/competencias/")}>
        <span class="name">Competências</span><span class="count">[0{skills.length}]</span>
      </a>
      <a class="module-link" href={url("/certificacoes/")}>
        <span class="name">Certificações</span><span class="count">[{certTotal}]</span>
      </a>
    </nav>

    {
      extras.length > 0 && (
        <>
          <h2 class="section-rule">
            Mais no GitHub <span class="count">[{en}]</span>
          </h2>
          <RepoList repos={extras} />
        </>
      )
    }
  </div>
</Layout>

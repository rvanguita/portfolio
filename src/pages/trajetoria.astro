---
import Layout from "@components/layout/Layout.astro";
import Timeline from "@components/viz/Timeline.astro";
import { url } from "@lib/url";
---

<Layout
  title="Trajetória · rvanguita"
  description="Formação e pesquisa de Rene Anguita, de 2012 a 2026 — do bacharelado em Engenharia Elétrica ao doutorado na UNICAMP, num eixo de tempo real."
  current="trajetoria"
>
  <div class="page">
    <a class="backlink" href={url("/")}>← Painel</a>
    <div class="mod-head">
      <h1>Trajetória</h1>
      <span class="count">2012–26</span>
    </div>
    <p class="module-intro">
      Formação em Engenharia Elétrica e pesquisa aplicada construindo a base
      para resolver problemas de dados com visão sistêmica.
    </p>
    <Timeline />
  </div>
</Layout>

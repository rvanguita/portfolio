---
import Layout from "@components/layout/Layout.astro";
import Timeline from "@components/viz/Timeline.astro";
import { url } from "@lib/url";
---

<Layout
  title="Trajetória · Rene Anguita"
  description="Formação e experiência de Rene Anguita: doutorado em Engenharia Elétrica pela UNICAMP, pesquisa aplicada, otimização e análise de dados."
  current="trajetoria"
>
  <div class="page">
    <a class="backlink" href={url("/")}>← Início</a>
    <div class="mod-head"><h1>Trajetória</h1></div>
    <p class="module-intro">
      Uma formação em Engenharia Elétrica e pesquisa aplicada que sustenta meu
      trabalho com dados: modelar problemas, avaliar soluções e construir
      processos reproduzíveis.
    </p>
    <Timeline />
  </div>
</Layout>

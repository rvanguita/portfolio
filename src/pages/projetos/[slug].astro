---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import Layout from "@components/layout/Layout.astro";
import Readout from "@components/panels/Readout.astro";
import { url } from "@lib/url";

export const getStaticPaths = (async () => {
  const entries = await getCollection("projetos");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
---

<Layout
  title={`${data.title} · Rene Anguita`}
  description={data.description}
  ogType="article"
  current="projetos"
>
  <div class="page page--doc">
    <a class="backlink" href={url("/projetos/")}>← Todos os projetos</a>
    <article class="doc">
      <header class="doc-head">
        <p class="doc-cat">{data.category}</p>
        <h1>{data.title}</h1>
        {
          data.leadHtml ? (
            <p class="lead" set:html={data.leadHtml} />
          ) : (
            <p class="lead">{data.summary}</p>
          )
        }
        <div class="doc-actions">
          {
            data.repos.map((repo) => (
              <a
                class="button button--secondary"
                href={repo.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                Ver código · {repo.label} <span aria-hidden="true">↗</span>
              </a>
            ))
          }
        </div>
      </header>
      <Readout
        class="doc-readout"
        label={data.metric.label}
        value={data.metric.value}
        sub={data.metric.sub}
      />
      {
        data.kind === "full" ? (
          <div class="doc-body">
            <Content />
          </div>
        ) : (
          <dl class="spec">
            <>
              <dt>Problema</dt>
              <dd>{data.spec?.problema}</dd>
            </>
            <>
              <dt>Dados</dt>
              <dd>{data.spec?.dados}</dd>
            </>
            <>
              <dt>Método</dt>
              <dd>{data.spec?.metodo}</dd>
            </>
            <>
              <dt>Resultado</dt>
              <dd set:html={data.spec?.resultado} />
            </>
          </dl>
        )
      }
      <div class="tech">
        <p>Tecnologias utilizadas</p>
        <ul class="tech-tags">
          {data.stack.split(" · ").map((tech) => <li>{tech}</li>)}
        </ul>
      </div>
    </article>
    <a class="text-link" href={url("/projetos/")}
      >Explorar outros projetos <span aria-hidden="true">→</span></a
    >
  </div>
</Layout>

---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import Layout from "@components/layout/Layout.astro";
import Trilha from "@components/layout/Trilha.astro";
import Readout from "@components/panels/Readout.astro";
import Pipeline from "@components/viz/Pipeline.astro";
import { url, absoluteUrl } from "@lib/url";
import { tecnologiasDe, paginasDeTecnologia } from "@lib/stack";
import { METRIC_TAG } from "@lib/metric";
import { profile } from "@data/profile";

export const getStaticPaths = (async () => {
  const entries = (await getCollection("projetos")).sort(
    (a, b) => a.data.order - b.data.order,
  );
  // Qual tecnologia tem página, para a etiqueta virar elo só quando há destino.
  // Vem da mesma função que gera as rotas, então as duas não podem divergir.
  const comPagina = Object.fromEntries(
    paginasDeTecnologia(entries).map((pagina) => [pagina.nome, pagina.slug]),
  );
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: entries[i - 1], next: entries[i + 1], comPagina },
  }));
}) satisfies GetStaticPaths;

const { entry, prev, next, comPagina } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const trilha = [
  { rotulo: "Início", href: url("/") },
  { rotulo: "Projetos", href: url("/projetos/") },
  { rotulo: data.title },
];

// Schema da ficha. Vale a mesma regra do `knowsAbout` da abertura: só entra o
// que a página mostra. Todo campo abaixo sai do frontmatter que já é renderizado
// — nada é acrescentado para enfeitar a indexação.
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: data.title,
  description: data.summary,
  url: absoluteUrl(url(`/projetos/${entry.id}/`), Astro.site),
  programmingLanguage: data.stack.split(" · "),
  about: data.category.split(" · "),
  // O tipo de resultado, no mesmo vocabulário que o cartão e a legenda usam.
  creativeWorkStatus: METRIC_TAG[data.metricKind],
  author: { "@type": "Person", name: profile.name },
  ...(data.repos.length > 0 && { codeRepository: data.repos[0].url }),
};

// Espelha a trilha visível, item a item. A regra do metadado com lastro vale
// aqui igual: trilha estruturada sem trilha na página seria afirmar navegação
// que o leitor não tem.
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: trilha.map((item, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: item.rotulo,
    ...(item.href && { item: absoluteUrl(item.href, Astro.site) }),
  })),
};
---

<Layout
  title={`${data.title} · Rene Anguita`}
  description={data.description}
  ogType="article"
  current="projetos"
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumb)}
  />

  <div class="page page--doc">
    <Trilha itens={trilha} />
    <article class="doc">
      <header class="doc-head">
        <p class="doc-cat">{data.category} · {data.periodo}</p>
        <h1>{data.title}</h1>
        {
          data.leadHtml ? (
            <p class="lead" set:html={data.leadHtml} />
          ) : (
            <p class="lead">{data.summary}</p>
          )
        }
        <div class="doc-actions">
          {
            data.repos.map((repo) => (
              <a
                class="button button--secondary"
                href={repo.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                Ver código · {repo.label} <span aria-hidden="true">↗</span>
              </a>
            ))
          }
        </div>
      </header>

      {
        data.kind === "full" ? (
          <div class="doc-body">
            <Content />
          </div>
        ) : (
          <dl class="spec">
            <>
              <dt>Problema</dt>
              <dd>{data.spec?.problema}</dd>
            </>
            <>
              <dt>Dados</dt>
              <dd>{data.spec?.dados}</dd>
            </>
            <>
              <dt>Método</dt>
              <dd>{data.spec?.metodo}</dd>
            </>
            <>
              <dt>Resultado</dt>
              <dd set:html={data.spec?.resultado} />
            </>
          </dl>
        )
      }

      {
        /* Trilho lateral: a aferição e as tecnologias ficam conferíveis sem
          precisar descer a prosa inteira. */
      }
      <aside class="doc-rail" aria-label="Ficha técnica">
        <div class="doc-rail-block">
          <h2>Resultado e contexto</h2>
          <Readout
            kind={data.metricKind}
            label={data.metric.label}
            value={data.metric.value}
            sub={data.metric.sub}
          />
        </div>
        <div class="doc-rail-block">
          <h2>Tecnologias</h2>
          <ul class="tech-tags">
            {
              tecnologiasDe(data.stack).map((tech) =>
                comPagina[tech] ? (
                  <li>
                    <a
                      class="tech-link"
                      href={url(`/projetos/stack/${comPagina[tech]}/`)}
                    >
                      {tech}
                    </a>
                  </li>
                ) : (
                  <li>{tech}</li>
                ),
              )
            }
          </ul>
        </div>
      </aside>

      {
        /* O diagrama sai do frontmatter do próprio projeto: quatro dos nove
           têm arquitetura em camadas de verdade e passam a mostrá-la, em vez
           de descrever Raw/Bronze/Silver só em prosa. */
        data.architecture && (
          <Pipeline
            architecture={data.architecture}
            variant="full"
            class="doc-figure"
            headingId="pipeline-ficha"
          />
        )
      }
    </article>

    <nav class="doc-nav" aria-label="Outros projetos">
      {
        prev ? (
          <a href={url(`/projetos/${prev.id}/`)}>
            <span>← Projeto anterior</span>
            <b>{prev.data.title}</b>
          </a>
        ) : (
          <a href={url("/projetos/")}>
            <span>← Catálogo</span>
            <b>Todos os projetos</b>
          </a>
        )
      }
      {
        next ? (
          <a href={url(`/projetos/${next.id}/`)}>
            <span>Próximo projeto →</span>
            <b>{next.data.title}</b>
          </a>
        ) : (
          <a href={url("/projetos/")}>
            <span>Catálogo →</span>
            <b>Todos os projetos</b>
          </a>
        )
      }
    </nav>
  </div>
</Layout>

---
import { getCollection } from "astro:content";
import Layout from "@components/layout/Layout.astro";
import Channels from "@components/panels/Channels.astro";
import MetricLegend from "@components/panels/MetricLegend.astro";
import { url } from "@lib/url";
const projects = (await getCollection("projetos")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout
  title="Projetos · Rene Anguita"
  description="Projetos de Engenharia de Dados, pipelines e lakehouses, com aplicações de machine learning e otimização. Problemas, decisões técnicas, resultados e repositórios."
  current="projetos"
>
  <div class="page">
    <a class="backlink" href={url("/")}>← Início</a>
    <div class="mod-head">
      <h1>Projetos</h1>
      <span class="count">{projects.length} projetos</span>
    </div>
    <p class="module-intro">
      Da ingestão ao consumo dos dados. Conheça a arquitetura, as escolhas
      técnicas e os resultados de cada projeto — com acesso ao código.
    </p>
    <Channels projects={projects} level={2} />
    <section class="legend-section" aria-labelledby="sobre-resultados">
      <h2 id="sobre-resultados">Sobre os resultados</h2>
      <MetricLegend />
    </section>
  </div>
</Layout>

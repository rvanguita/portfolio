---
import Layout from "@components/layout/Layout.astro";
import { certGroups, certTotal } from "@data/certificates";
import { url } from "@lib/url";

/** Preserva barras e pontuação válida no caminho, inclusive na prévia Astro. */
const certUrl = (file: string) =>
  url(
    "/certificates/" +
      file
        .split("/")
        .map((segment) =>
          encodeURIComponent(segment).replace(/%3A/g, ":").replace(/%2C/g, ","),
        )
        .join("/"),
  );
---
<Layout
  title="Certificações · Rene Anguita"
  description={`${certTotal} certificações e especializações concluídas em Python, ciência de dados, matemática, machine learning e estatística empresarial, com certificados disponíveis.`}
  current="certificacoes"
>
  <div class="page">
    <a class="backlink" href={url("/")}>← Início</a>
    <div class="mod-head">
      <h1>Certificações</h1><span class="count">{certTotal} certificados</span>
    </div>
    <p class="module-intro">
      Formação complementar em Python, estatística, machine learning e análise
      de negócios. Consulte os certificados de cada curso e especialização.
    </p>
    <div class="certs">
      {certGroups.map((group) => (
        <section class="certs-group">
          <h2>{group.title}</h2>
          <ul>
            {group.items.map((certificate) => (
              <li>
                <a href={certUrl(certificate.file)} target="_blank" rel="noopener noreferrer">
                  <span>{certificate.name}<span class="sr-only"> — certificado em PDF, abre em nova aba</span></span>
                  <span aria-hidden="true">↗</span>
                </a>
                <span class="issuer">{certificate.issuer}</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Layout>

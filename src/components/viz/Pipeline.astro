---
// Diagrama de arquitetura em camadas, fiel ao estudo de caso que o alimenta.
// Os dados vêm do frontmatter do projeto (`architecture`), não do componente:
// cada projeto desenha a SUA arquitetura, e nenhum diagrama pode afirmar uma
// camada que o texto do caso não descreve — o Rota do Perfume, por exemplo,
// vai de bronze a gold e não tem camada raw.
//
// Os nós são uma <ol>: a ordem das camadas é informação, não estilo. Os
// conectores são desenhados no CSS (::before/::after de cada nó), então o
// fluxo é um fluxo de verdade e não uma pilha de retângulos.
//
// `compact` desce na vertical na abertura; `full` corre na horizontal a
// partir de 70rem na ficha. Em telas menores, ambas as variantes empilham.
// A grade horizontal segue a contagem real de estágios e saídas, via
// --stage-count / --output-count — sem número mágico no CSS.
//
// A figura não repete o nome do projeto nem o link para a ficha: os dois
// lugares onde ela aparece já identificam o projeto. O nome acessível vem
// do rótulo "Fluxo de dados".
//
// Os rótulos fixos da figura são genéricos de propósito. Dois dos quatro
// projetos são medalhão em MySQL e não têm lakehouse: nomear a arquitetura
// aqui afirmaria, para quem usa leitor de tela, uma camada que o estudo de
// caso não descreve. O que é por projeto vem todo de `architecture`.

interface Stage {
  layer: "source" | "raw" | "bronze" | "silver" | "gold";
  name: string;
  detail: string;
  tech: string;
}
interface Architecture {
  caption: string;
  orchestrator?: string;
  stages: Stage[];
  outputs: { role: string; tech: string }[];
}
interface Props {
  architecture: Architecture;
  variant?: "compact" | "full";
  headingId?: string;
  class?: string;
}
const {
  architecture,
  variant = "compact",
  headingId = "pipeline-title",
  class: cls,
} = Astro.props;

const { caption, orchestrator, stages, outputs } = architecture;
---

<figure
  class:list={["pipeline", `pipeline--${variant}`, cls]}
  aria-labelledby={headingId}
  style={`--stage-count:${stages.length};--output-count:${outputs.length}`}
>
  <figcaption class="pipeline-heading">
    <span class="eyebrow" id={headingId}>Fluxo de dados</span>
    {variant === "full" && <span class="pipeline-caption">{caption}</span>}
  </figcaption>

  {orchestrator && <p class="pipeline-orchestrator">{orchestrator}</p>}

  <ol class="pipeline-stages" aria-label="Fluxo da ingestão às camadas">
    {
      stages.map((stage) => (
        <li class:list={["pipeline-node", `pipeline-node--${stage.layer}`]}>
          <b>{stage.name}</b>
          <span class="pipeline-tech">{stage.tech}</span>
          <span class="pipeline-detail">{stage.detail}</span>
        </li>
      ))
    }
  </ol>

  {
    outputs.length > 0 && (
      <ul class="pipeline-outputs" aria-label="Consumo dos dados">
        {outputs.map((out) => (
          <li>
            <span>{out.role}</span>
            <b>{out.tech}</b>
          </li>
        ))}
      </ul>
    )
  }
</figure>

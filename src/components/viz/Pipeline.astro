---
// Diagrama fiel ao estudo de caso do FastF1: ingestão pela biblioteca FastF1,
// Raw particionado em Parquet, Bronze/Silver em Delta Lake, orquestração
// semanal no Airflow e consumo por FastAPI e Streamlit. O modelo preditivo do
// projeto é experimental e não tem métrica de referência publicada — nada aqui
// deve sugerir o contrário.
//
// Os nós são uma <ol>: a ordem das camadas é informação, não estilo. Os
// conectores são desenhados no CSS (::before/::after de cada nó), então o
// fluxo é um fluxo de verdade e não uma pilha de retângulos.
//
// `compact` desce na vertical na abertura; `full` corre na horizontal a
// partir de 70rem na ficha. Em telas menores, ambas as variantes empilham.
//
// A figura não repete o nome do projeto nem o link para a ficha: os dois
// lugares onde ela aparece já identificam o projeto. O nome acessível vem
// do rótulo "Fluxo de dados".

interface Props {
  variant?: "compact" | "full";
  headingId?: string;
  class?: string;
}
const {
  variant = "compact",
  headingId = "pipeline-title",
  class: cls,
} = Astro.props;

const stages = [
  {
    layer: "source",
    name: "Ingestão",
    detail: "Corridas, sessões e telemetria",
    tech: "FastF1",
  },
  {
    layer: "raw",
    name: "Raw",
    detail: "Dados brutos particionados",
    tech: "Parquet",
  },
  {
    layer: "bronze",
    name: "Bronze",
    detail: "Tabelas com versionamento ACID",
    tech: "Delta Lake",
  },
  {
    layer: "silver",
    name: "Silver",
    detail: "Dados curados e agregados",
    tech: "PySpark",
  },
];

const outputs = [
  { role: "API", tech: "FastAPI" },
  { role: "Painel", tech: "Streamlit" },
];
---

<figure
  class:list={["pipeline", `pipeline--${variant}`, cls]}
  aria-labelledby={headingId}
>
  <figcaption class="pipeline-heading">
    <span class="eyebrow" id={headingId}>Fluxo de dados</span>
    {
      variant === "full" && (
        <span class="pipeline-caption">
          Da telemetria à análise de corridas — o fluxo completo do FastF1.
        </span>
      )
    }
  </figcaption>

  <p class="pipeline-orchestrator">Orquestração semanal · Apache Airflow</p>

  <ol
    class="pipeline-stages"
    aria-label="Fluxo da ingestão às camadas do lakehouse"
  >
    {
      stages.map((stage) => (
        <li class:list={["pipeline-node", `pipeline-node--${stage.layer}`]}>
          <b>{stage.name}</b>
          <span class="pipeline-tech">{stage.tech}</span>
          <span class="pipeline-detail">{stage.detail}</span>
        </li>
      ))
    }
  </ol>

  <ul class="pipeline-outputs" aria-label="Consumo dos dados">
    {
      outputs.map((out) => (
        <li>
          <span>{out.role}</span>
          <b>{out.tech}</b>
        </li>
      ))
    }
  </ul>
</figure>

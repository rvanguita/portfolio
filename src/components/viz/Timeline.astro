---
import { timeline } from "@data/timeline";

interface Props {
  // Quantas entradas mostrar. Sem valor, mostra as nove.
  limit?: number;
  // Nível do título de cada entrada. A página de trajetória tem um <h1> e usa
  // h2; a home já gastou o h2 no título da seção, então usa h3.
  level?: 2 | 3;
  label?: string;
}
const { limit, level = 2, label = "Formação e experiência" } = Astro.props;

const Title = `h${level}` as "h2" | "h3";
const entries = limit ? timeline.slice(0, limit) : timeline;
---

<ol class="timeline" aria-label={label}>
  {
    entries.map((entry) => (
      <li class="tl-row">
        <p class="tl-years">{entry.years}</p>
        <Title class="tl-title">{entry.title}</Title>
        <p class="tl-org">{entry.org}</p>
        {entry.note && <p class="tl-note">{entry.note}</p>}
      </li>
    ))
  }
</ol>

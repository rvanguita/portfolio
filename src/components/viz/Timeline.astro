---
import { timeline } from "@data/timeline";
---

<ol class="timeline" aria-label="Formação e experiência">
  {
    timeline.map((entry) => (
      <li class="tl-row">
        <p class="tl-years">{entry.years}</p>
        <h2 class="tl-title">{entry.title}</h2>
        <p class="tl-org">{entry.org}</p>
        {entry.note && <p class="tl-note">{entry.note}</p>}
      </li>
    ))
  }
</ol>

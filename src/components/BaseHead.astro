---
import { profile } from "../data/profile";
import { url, absoluteUrl } from "../lib/url";

interface Props {
  title: string;
  description?: string;
  ogType?: "website" | "article";
}
const { title, description = profile.description, ogType = "website" } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = absoluteUrl(url(profile.ogImage), Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href={url("/icon.svg")} />
<link rel="icon" type="image/png" href={url("/icon.png")} />
<link rel="apple-touch-icon" href={url("/icon.png")} />
<meta name="theme-color" content="#f7f8f8" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0e1113" media="(prefers-color-scheme: dark)" />
<meta name="generator" content={Astro.generator} />

<meta property="og:type" content={ogType} />
<meta property="og:locale" content="pt_BR" />
<meta property="og:site_name" content="rvanguita" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Rene Anguita — Cientista de Dados & Ph.D. Engenharia Elétrica" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

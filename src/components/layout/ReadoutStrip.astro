---
import { NAV, type NavKey } from "@/config";
import { profile } from "@data/profile";
import { url } from "@lib/url";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  current?: NavKey;
}
const { current } = Astro.props;
---

<header class="strip">
  <a
    class="strip-id"
    href={url("/")}
    aria-label={`${profile.shortName} — Início`}
  >
    <span class="brand-mark" aria-hidden="true">{profile.initials}</span>
    <b>{profile.shortName}</b>
  </a>
  <nav class="strip-nav" aria-label="Seções do site">
    {
      NAV.map((n) => (
        <a
          href={url(n.href)}
          aria-current={current === n.key ? "page" : undefined}
        >
          {n.label}
        </a>
      ))
    }
  </nav>
  <ThemeToggle />
</header>

---
import { profile } from "@data/profile";
import { url } from "@lib/url";
---

<footer class="foot">
  <div class="foot-inner">
    <div class="foot-main">
      <div>
        <p class="foot-name">{profile.shortName}</p>
        <p class="foot-role">{profile.roleShort} · {profile.location}</p>
        <a class="text-link" href={`mailto:${profile.email}`}>{profile.email}</a
        >
      </div>
      <nav class="foot-links" aria-label="Contato e perfil profissional">
        <a
          href={profile.links.linkedin}
          target="_blank"
          rel="noopener noreferrer">LinkedIn ↗</a
        >
        <a href={profile.links.github} target="_blank" rel="noopener noreferrer"
          >GitHub ↗</a
        >
        <a
          href={url(profile.links.dossie)}
          target="_blank"
          rel="noopener noreferrer">Dossiê profissional (PDF) ↓</a
        >
      </nav>
    </div>
    {
      /* A evidência de prática de engenharia é o repositório, não o adjetivo:
        a frase diz o que dá para conferir e o elo leva a onde conferir. */
    }
    <div class="foot-colofon">
      <p>
        Site estático em Astro, sem JavaScript de cliente. Cada PR passa por uma
        suíte de invariantes no CI.
      </p>
      <a
        class="text-link"
        href={profile.links.repo}
        target="_blank"
        rel="noopener noreferrer">Código deste site ↗</a
      >
    </div>
    <p class="foot-bottom">© {new Date().getFullYear()} {profile.name}</p>
  </div>
</footer>

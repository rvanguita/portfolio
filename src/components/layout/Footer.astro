---
import { profile } from "@data/profile";
import { url } from "@lib/url";
---

<footer class="foot">
  <div class="foot-inner">
    <div class="foot-main">
      <div>
        <p class="foot-name">{profile.shortName}</p>
        <p class="foot-role">{profile.roleShort} · {profile.location}</p>
        <a class="text-link" href={`mailto:${profile.email}`}>{profile.email}</a
        >
      </div>
      <nav class="foot-links" aria-label="Contato e perfil profissional">
        <a
          href={profile.links.linkedin}
          target="_blank"
          rel="noopener noreferrer">LinkedIn ↗</a
        >
        <a href={profile.links.github} target="_blank" rel="noopener noreferrer"
          >GitHub ↗</a
        >
        <a
          href={url(profile.links.dossie)}
          target="_blank"
          rel="noopener noreferrer">Dossiê profissional (PDF) ↓</a
        >
      </nav>
    </div>
    <p class="foot-bottom">© {new Date().getFullYear()} {profile.name}</p>
  </div>
</footer>

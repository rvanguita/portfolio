---
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@styles/global.css";

import type { NavKey } from "@/config";
import BaseHead from "./BaseHead.astro";
import ReadoutStrip from "./ReadoutStrip.astro";
import Footer from "./Footer.astro";

interface Props {
  title: string;
  description?: string;
  ogType?: "website" | "article";
  current?: NavKey;
}
const { title, description, ogType, current } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={title} description={description} ogType={ogType} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <ReadoutStrip current={current} />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

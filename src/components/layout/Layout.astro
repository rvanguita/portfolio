---
// Três vozes: Archivo (display, com os eixos de peso E largura — o display abre
// para ~109%, leitura de painel de instrumento), IBM Plex Sans (texto) e IBM
// Plex Mono (dados). O arquivo latin do Archivo sai de 35 KB para 90 KB com o
// eixo de largura; é font-display: swap, então não bloqueia o render.
// Só os subsets latin/latin-ext — o site é em português, e importar os arquivos
// cheios trazia 28 @font-face (cirílico, grego, vietnamita) para nada.
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-ext-400.css";
import "@fontsource/ibm-plex-sans/latin-500.css";
import "@fontsource/ibm-plex-sans/latin-ext-500.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-ext-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "@fontsource/ibm-plex-mono/latin-ext-500.css";
import "@styles/global.css";

import type { NavKey } from "@/config";
import BaseHead from "./BaseHead.astro";
import ReadoutStrip from "./ReadoutStrip.astro";
import Footer from "./Footer.astro";

interface Props {
  title: string;
  description?: string;
  ogType?: "website" | "article";
  current?: NavKey;
}
const { title, description, ogType, current } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={title} description={description} ogType={ogType} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <ReadoutStrip current={current} />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

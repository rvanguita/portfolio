---
// Toggle claro/escuro sem JS: checkbox oculto + label; o :root:has(#theme-toggle:checked)
// em tokens.css inverte os tokens. Portado 1:1 do site anterior.
---

<input type="checkbox" id="theme-toggle" class="theme-toggle" />
<label
  for="theme-toggle"
  class="theme-toggle-btn"
  title="Alternar tema claro/escuro"
>
  <span class="sr-only">Alternar tema claro/escuro</span>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z"></path>
  </svg>
</label>

---
import type { CollectionEntry } from "astro:content";
import { url } from "@lib/url";
import Readout from "./Readout.astro";

interface Props {
  projects: CollectionEntry<"projetos">[];
  level?: 2 | 3;
}
const { projects, level = 3 } = Astro.props;
const Title = `h${level}` as "h2" | "h3";
---

<div class="channels">
  {projects.map((p) => (
    <article class="project-card">
      <p class="project-category">{p.data.category}</p>
      <Title class="project-title"><a href={url(`/projetos/${p.id}/`)}>{p.data.title}</a></Title>
      <Readout class="project-outcome" kind={p.data.metricKind} label={p.data.metric.label} value={p.data.metric.value} sub={p.data.metric.sub} />
      <p class="project-summary">{p.data.summary}</p>
      <ul class="tech-tags project-tech" aria-label={`Tecnologias de ${p.data.title}`}>
        {p.data.stack.split(" · ").map((tech) => <li>{tech}</li>)}
      </ul>
      <div class="project-links">
        <a class="text-link" href={url(`/projetos/${p.id}/`)}>
          {p.data.kind === "full" ? "Ver estudo de caso" : "Conhecer o projeto"} <span aria-hidden="true">→</span>
        </a>
        {p.data.repos.map((r) => (
          <a href={r.url} target="_blank" rel="noopener noreferrer" aria-label={`${r.label} — ${p.data.title}`}>
            {r.label} <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </article>
  ))}
</div>

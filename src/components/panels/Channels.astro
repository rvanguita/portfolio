---
import type { CollectionEntry } from "astro:content";
import { url } from "@lib/url";
import Readout from "./Readout.astro";

interface Props {
  projects: CollectionEntry<"projetos">[];
  level?: 2 | 3;
  columns?: 2 | 3;
}
const { projects, level = 3, columns = 3 } = Astro.props;
const Title = `h${level}` as "h2" | "h3";
---

<div class:list={["channels", columns === 2 && "channels--pair"]}>
  {projects.map((project) => (
    <article class="project-card">
      <p class="project-category">{project.data.category}</p>
      <Title class="project-title"><a href={url(`/projetos/${project.id}/`)}>{project.data.title}</a></Title>
      <p class="project-summary">{project.data.summary}</p>
      <Readout class="project-outcome" kind={project.data.metricKind} label={project.data.metric.label} value={project.data.metric.value} sub={project.data.metric.sub} />
      <ul class="tech-tags project-tech" aria-label={`Principais tecnologias de ${project.data.title}`}>
        {project.data.stack.split(" · ").slice(0, 5).map((tech) => <li>{tech}</li>)}
      </ul>
      <div class="project-links">
        <a href={url(`/projetos/${project.id}/`)}>
          {project.data.kind === "full" ? "Ver estudo de caso" : "Conhecer o projeto"} <span aria-hidden="true">→</span>
        </a>
        {project.data.repos.map((repo) => (
          <a href={repo.url} target="_blank" rel="noopener noreferrer" aria-label={`${repo.label} — ${project.data.title}`}>
            {repo.label} <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </article>
  ))}
</div>

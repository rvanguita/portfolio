---
import type { CollectionEntry } from "astro:content";
import { url } from "@lib/url";
import Readout from "./Readout.astro";
import Trace from "@components/viz/Trace.astro";

interface Props {
  projects: CollectionEntry<"projetos">[];
  level?: 2 | 3;
}
const { projects, level = 3 } = Astro.props;
const Title = `h${level}` as "h2" | "h3";
---

<div class="channels">
  {
    projects.map((p) => (
      <article class="panel">
        <div class="panel-tab">
          <span>{p.data.category}</span>
          <span class="ref">{p.data.kind === "full" ? "estudo de caso" : "ficha"}</span>
        </div>

        <div class="channel-head">
          <Title class="panel-title">
            <a href={url(`/projetos/${p.id}/`)}>{p.data.title}</a>
          </Title>
          <Readout
            class="channel-metric"
            label={p.data.metric.label}
            value={p.data.metric.value}
            sub={p.data.metric.sub}
          />
        </div>

        <p class="channel-summary">{p.data.summary}</p>

        <Trace class="channel-trace" variant={p.data.trace} />

        <p class="channel-stack">{p.data.stack}</p>

        <p class="channel-links">
          <a href={url(`/projetos/${p.id}/`)}>
            {p.data.kind === "full" ? "Estudo de caso →" : "Ficha →"}
          </a>
          {p.data.repos.map((r) => (
            <a href={r.url} target="_blank" rel="noopener noreferrer">
              {r.label} ↗
            </a>
          ))}
        </p>
      </article>
    ))
  }
</div>

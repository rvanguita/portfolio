---
import { getCollection } from "astro:content";
import { skills } from "@data/skills";
import { url } from "@lib/url";
import { paginasDeTecnologia } from "@lib/stack";

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const projects = await getCollection("projetos");

// A página da tecnologia é o destino certo de um item que vários projetos
// demonstram — e só existe com dois projetos ou mais atrás.
//
// O casamento é por nome exato, de propósito. "Python" e "Docker" casam; itens
// que juntam duas ferramentas ("XGBoost / LightGBM") ou uma prática
// ("Pytest / testes automatizados") não casam, e continuam apontando para o
// projeto de maior prioridade. Aproximar a comparação faria o elo prometer uma
// página que responde por outra coisa.
const paginaPorTecnologia = new Map(
  paginasDeTecnologia(projects).map((pagina) => [pagina.nome, pagina.slug]),
);
const find = (id: string) => {
  const project = projects.find((entry) => entry.id === id);
  if (!project)
    throw new Error(`Projeto não encontrado nas competências: ${id}`);
  return project;
};

const groups = skills.map((group) => ({
  ...group,
  projects: group.projectIds.map(find),
  items: group.items.map((item) => {
    // Quando existe página da tecnologia, o elo vai para ela: o item deixa de
    // apontar para um projeto e passa a apontar para todos os que o demonstram.
    const pagina = paginaPorTecnologia.get(item.name);
    if (pagina) {
      return {
        ...item,
        href: url(`/projetos/stack/${pagina}/`),
        titulo: `Projetos com ${item.name}`,
      };
    }
    // Sem página, o elo aponta para o projeto de maior prioridade no catálogo
    // que demonstra o item — `projectIds` já vem nessa ordem. Item sem projeto
    // fica sem elo, em vez de apontar para algo que não o comprova.
    const evidence = item.projectIds.map(find)[0];
    return {
      ...item,
      href: evidence ? url(`/projetos/${evidence.id}/`) : undefined,
      titulo: evidence ? `${item.name} em ${evidence.data.title}` : undefined,
    };
  }),
}));
---

<div class:list={["skills", compact && "skills--compact"]}>
  {
    groups.map((group) => (
      <section class="skill">
        <div class="skill-head">
          {compact ? <h3>{group.title}</h3> : <h2>{group.title}</h2>}
        </div>
        <div class="skill-body">
          <p class="skill-summary">{group.summary}</p>
          {!compact && (
            <ul
              class="tech-tags"
              aria-label={`Tecnologias e métodos de ${group.title}`}
            >
              {group.items.map((item) =>
                item.href ? (
                  <li>
                    <a class="tech-link" href={item.href} title={item.titulo}>
                      {item.name}
                    </a>
                  </li>
                ) : (
                  <li>{item.name}</li>
                ),
              )}
            </ul>
          )}
          <ul class="skill-evidence" aria-label={`Projetos de ${group.title}`}>
            {group.projects.map((project) => (
              <li>
                <a href={url(`/projetos/${project.id}/`)}>
                  {project.data.title} <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }
</div>
